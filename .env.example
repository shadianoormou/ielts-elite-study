# Use SQL Server when the pyodbc package and Microsoft ODBC driver are installed.
IELTS_DB_BACKEND=sqlserver
IELTS_SQLSERVER_CONNECTION_STRING=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost,1433;DATABASE=IELTS_Elite;UID=YOUR_USER;PWD=YOUR_PASSWORD;Encrypt=no;TrustServerCertificate=yes

# For the private local recovery mode only:
# IELTS_DB_BACKEND=sqlite

# Optional server-side tutor integration. Never commit a real API key.
# OPENAI_API_KEY=...
# OPENAI_MODEL=...

# Free local AI alternative (install Ollama and pull a model, then use this instead).
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2:3b
